# Credentials come from MACHINE ENVIRONMENT VARIABLES by default:
#
#     derq-api-key      DERQ INSIGHT API key
#     agol-username     ArcGIS account with edit rights on Transportation_SMART
#     agol-password
#
# Set those once per machine (System Properties > Environment Variables, or
# `setx`) and no .env file is needed at all.
#
# A .env file in this directory is OPTIONAL and overrides the machine values
# for this checkout only -- useful for testing alternate credentials. Copy this
# file to .env and fill in only what you want to override. .env is gitignored;
# never commit it.

# --- overrides (underscore names take precedence over the machine variables) ---
#DERQ_API_KEY=
#ARCGIS_USERNAME=
#ARCGIS_PASSWORD=
#ARCGIS_PORTAL_URL=https://maps.trpa.org/portal

# --- safety switch ---
# true  = simulate everything, write nothing (the default)
# false = write to the feature service
# Overridden per-run by the --live / --dry-run flags on run_etl.py.
#DRY_RUN=true

# --- run summary email (defaults live in config.yaml under email:) ---
#EMAIL_FROM=info@trpa.org
#EMAIL_TO=gis@trpa.gov
#SMTP_HOST=mail.smtp2go.com
#SMTP_PORT=25
